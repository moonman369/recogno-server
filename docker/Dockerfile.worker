# Production image for @recogno/worker. Build from the repo root:
#   docker build -f docker/Dockerfile.worker -t recogno-worker .

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app
# Hoisted layout (see docker/.npmrc) so a plain node_modules copy is enough
# for the runtime stage to resolve every dependency.
COPY docker/.npmrc .npmrc

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/
COPY packages/worker/package.json packages/worker/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @recogno/worker build

# Separate, --prod-only install so devDependencies (tsup, tsx, typescript,
# drizzle-kit, vitest, biome...) never end up in the runtime image.
# `shamefully-hoist` (docker/.npmrc) computes the full flat dependency set -
# direct and transitive, across worker and the shared package it bundles - at
# node_modules/.pnpm/node_modules; dereferencing just that already-flat
# folder gives a plain node_modules the runtime stage can copy as-is.
FROM base AS prod-deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/
COPY packages/worker/package.json packages/worker/
RUN pnpm install --frozen-lockfile --prod --filter @recogno/worker... && \
    mkdir /prod_modules && cp -rL node_modules/.pnpm/node_modules/. /prod_modules/

FROM node:22-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=prod-deps /prod_modules ./node_modules
COPY --from=build /app/packages/worker/dist ./dist
USER node
CMD ["node", "dist/index.js"]
