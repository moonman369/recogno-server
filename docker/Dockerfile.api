# Placeholder image for @recogno/api — scaffolded, not yet production-hardened.
# Build from the repo root:  docker build -f docker/Dockerfile.api -t recogno-api .

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/
COPY packages/worker/package.json packages/worker/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @recogno/api build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app/packages/api/dist ./dist
COPY --from=build /app/packages/api/node_modules ./node_modules
USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]
