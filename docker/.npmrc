# Used only inside Docker builds (copied in as .npmrc before `pnpm install`).
# shamefully-hoist flattens every dependency - direct and transitive, across
# every workspace package - into the single root node_modules. Without it,
# pnpm's per-package node_modules (packages/api/node_modules,
# packages/shared/node_modules, ...) only resolve for files living inside
# that package's own directory tree; a tsup bundle that inlines
# @recogno/shared's source but keeps its npm deps external (pino, postgres,
# ioredis, ...) needs all of it reachable from one root node_modules instead.
# Local dev keeps using the repo-root .npmrc (no hoisting) as-is.
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
