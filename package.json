{
  "name": "recogno-server",
  "version": "1.0.0",
  "private": true,
  "description": "API + worker for Recogno, a spaced-repetition DSA/system-design prep app",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @recogno/api dev",
    "dev:worker": "pnpm --filter @recogno/worker dev",
    "build": "pnpm --recursive run build",
    "db:generate": "pnpm --filter @recogno/shared db:generate",
    "db:migrate": "pnpm --filter @recogno/shared db:migrate",
    "db:seed": "pnpm --filter @recogno/shared db:seed",
    "openapi:export": "pnpm --filter @recogno/api openapi:export",
    "test": "vitest run",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
