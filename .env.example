# Copy to .env and fill in real values. Never commit .env.

# Self-hosted Postgres 18 connection string. Pick the form that matches where
# this process runs relative to the database:
#   same docker network:  postgresql://recogno:<password>@postgres:5432/recogno
#   app on the DB host:   postgresql://recogno:<password>@localhost:5432/recogno
#   remote app host:      postgresql://recogno:<password>@<db-host>:5432/recogno?sslmode=require
# Only the remote form needs TLS; the first two never leave the host. With a
# self-signed certificate `sslmode=require` is the right level — it encrypts
# without verifying the certificate. Percent-encode anything non-alphanumeric in
# the password: a raw `#` or `/` makes the URL unparseable and the process
# refuses to boot, and a raw `@` or `:` can silently split the URL in the wrong
# place. `#` is `%23`, `/` is `%2F`, `@` is `%40`, `:` is `%3A`.
DATABASE_URL=

# Redis connection string (BullMQ)
REDIS_URL=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: pin a specific Gemini model. Defaults to the gemini-flash-latest alias.
# GEMINI_MODEL=

# Telegram bot
TELEGRAM_BOT_TOKEN=

# Min 32 chars — signs access tokens and the OAuth state parameter
JWT_SECRET=

# Google sign-in. Optional: leave blank and /auth/google returns 501 while the
# rest of the API runs normally. Redirect URI must match the one registered in
# the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Where to send the browser after a successful Google sign-in. Tokens are added
# as query parameters. Omit it and the callback returns the session as JSON.
# OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# Where the frontend lives. Verification and password-reset emails link to
# <APP_BASE_URL>/verify-email?token=... and <APP_BASE_URL>/reset-password?token=...
APP_BASE_URL=http://localhost:5173

# Transactional email via Resend. Optional: without a key the API still issues
# tokens and reports success, and outside production it logs the link so local
# development needs no mail provider. MAIL_FROM must be on a domain verified in
# Resend; the default onboarding@resend.dev only delivers to your own address.
RESEND_API_KEY=
MAIL_FROM=Recogno <no-reply@moonman.in>

# development | test | production
NODE_ENV=development
