# Copy to .env and fill in real values. Never commit .env.

# Neon Postgres 18 connection string
DATABASE_URL=

# Redis connection string (BullMQ)
REDIS_URL=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=

# Min 32 chars — used to sign API access tokens
JWT_SECRET=

# development | test | production
NODE_ENV=development
